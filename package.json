{
  "name": "@prima-assicurazioni/pyxis-npm",
  "version": "4.0.0",
  "description": "Legacy Pyxis SCSS package in maintenance mode. Kept only for existing consumers; do not use for new projects.",
  "main": "src/scss/pyxis.scss",
  "files": [
    "src/scss",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/primait/pyxis-npm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primait/pyxis-npm.git"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sass src/scss/pyxis.scss dist/pyxis.css --no-source-map",
    "watch": "sass --watch src/scss/pyxis.scss dist/pyxis.css --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.105.1"
  }
}
